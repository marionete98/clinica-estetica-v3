logger = logging.getLogger(__name__)

# FAQ agent system prompt - revised (pt-BR)
FAQ_SYSTEM_PROMPT = """
Você é o **Agente de Informações** da Clínica Luana Carla Dermo.

Linguagem & Tom
- Responda em Português (Brasil) com voz profissional, calma e acolhedora.
- Use emojis leves (✨, 😊, 📌) com moderação, apenas quando ajudarem na clareza.

Missão
- Fornecer respostas corretas sobre tratamentos, preços, políticas e segurança.
- Conduzir o paciente ao próximo passo útil (agendamento, escalonamento, materiais extras).

Fonte de Verdade (crítico)
- Para toda pergunta, chame `search_knowledge_base(query)` antes de responder.
- Leia o conteúdo retornado, interprete e reescreva em português natural.
- Nunca cole a saída da ferramenta literalmente. Se faltar dado ou houver dúvida, explique e finalize com `ESCALATE_LOW_CONFIDENCE`.

Ferramentas de Apoio
- `search_knowledge_base`: base oficial da clínica.
- `get_message_template` + `format_template`: roteiros reutilizáveis quando apropriado.

Fluxo de Resposta
1) Confirme entendimento e identifique palavras-chave.
2) Execute `search_knowledge_base` com termos precisos (procedimento, área do corpo, política etc.).
3) Resuma achados em português, destacando benefícios, contraindicações e próximos passos.
4) Traga notas de segurança quando relevante (intervalos, preparo, pós-cuidados).
5) Ofereça uma ação concreta (agendar, escalar, enviar materiais).

Quando Escalonar
- Ausência de dados relevantes ou informação possivelmente desatualizada.
- Pedido de diagnóstico ou julgamento clínico individualizado.
- Negociação de preços, reclamações ou pedido explícito por humano.
- Sempre que houver incerteza: esclareça a lacuna e retorne `ESCALATE_LOW_CONFIDENCE`.

Estrutura Sugerida
- Saudação + reconhecimento da pergunta.
- Resumo claro (use listas curtas quando ajudar).
- Orientação prática (cuidados, prazos, documentação).
- Convite para continuar (agendar, falar com especialista, receber mais infos).

Boas Práticas
- Apresente benefícios do procedimento antes de faixas de preço.
- Traga contraindicações e políticas para evitar retrabalho.
- Ao citar números/prazos, deixe claro que a avaliação final é presencial.
- Ofereça ajuda extra: "Quer que eu te ajude a agendar?" / "Posso enviar resultados de antes e depois".

Exemplo
Paciente: "Quais são os cuidados depois da harmonização facial?"
Ideal: "Olá! 😊 Depois da harmonização facial, orientamos: 1) Evite exercícios por 24h; 2) Não massageie a área; 3) Hidrate bem. Se sentir algo diferente, avise a clínica. Posso agendar um retorno para te acompanhar?"

Seja a voz informativa da clínica: precisa, empática e orientada à ação.
"""


from config.redis_client import redis_client

class RedisFAQCache:
    """
    Cache for FAQ responses using Redis for persistence.
    """
    
    def __init__(self, ttl_seconds: int = 3600, max_size: int = 100):
        """
        Initialize Redis FAQ cache.
        
        Args:
            ttl_seconds: Time to live for cache entries in Redis (default: 1 hour)
            max_size: Maximum number of entries (for reference, Redis handles actual eviction)
        """
        self._redis_client = redis_client
        self._ttl_seconds = ttl_seconds
        self._max_size = max_size  # Max size is for reference, Redis handles actual eviction
        self._hits = 0
        self._misses = 0
        self._prefix = "faq_cache:" # Prefix for FAQ cache keys
    
    def _normalize_question(self, question: str) -> str:
        """
        Normalize question for cache key generation.
        
        Args:
            question: Original question
            
        Returns:
            Normalized question
        """
        # Convert to lowercase
        normalized = question.lower().strip()
        
        # Remove common variations
        replacements = {
            "quanto custa": "preço",
            "qual o valor": "preço",
            "qual valor": "preço",
            "quanto é": "preço",
            "quanto fica": "preço",
            "vocês fazem": "fazer",
            "vocês tem": "ter",
            "vocês trabalham com": "trabalhar",
            "pode fazer": "fazer",
            "posso fazer": "fazer",
        }
        
        for old, new in replacements.items():
            normalized = normalized.replace(old, new)
        
        # Remove punctuation
        normalized = normalized.replace("?", "").replace("!", "").replace(".", "")
        
        return normalized
    
    def _generate_cache_key(self, question: str) -> str:
        """
        Generate cache key from question.
        
        Args:
            question: Question text
            
        Returns:
            Cache key (hash)
        """
        normalized = self._normalize_question(question)
        return f"{self._prefix}{hashlib.md5(normalized.encode()).hexdigest()}"
    
    async def get(self, question: str) -> Optional[Dict[str, Any]]:
        """
        Get cached response for question from Redis.
        
        Args:
            question: Question text
            
        Returns:
            Cached response or None if not found/expired
        """
        cache_key = self._generate_cache_key(question)
        cached_response = await self._redis_client.get_value(cache_key, deserialize=True)
        
        if cached_response:
            self._hits += 1
            logger.info(
                f"FAQ cache HIT: question='{question[:50]}...', "
                f"hit_rate={self.get_hit_rate():.1%}"
            )
            return cached_response
        else:
            self._misses += 1
            return None
    
    async def set(self, question: str, response: Dict[str, Any]):
        """
        Cache response for question in Redis.
        
        Args:
            question: Question text
            response: Response to cache
        """
        # Only cache high confidence responses
        if response.get("confidence") != "high":
            return
        
        cache_key = self._generate_cache_key(question)
        await self._redis_client.set_value(cache_key, response, ttl=self._ttl_seconds)
        
        logger.debug(f"FAQ cached: question='{question[:50]}...'")
    
    async def clear(self):
        """
        Clear all FAQ cache entries from Redis and reset stats.
        """
        try:
            # Get all FAQ cache keys
            pattern = f"{self._prefix}*"
            keys = await self._redis_client.client.keys(pattern)
            # Delete all FAQ cache keys
            if keys:
                await self._redis_client.client.delete(*keys)
                logger.info(f"Cleared {len(keys)} FAQ cache entries from Redis")
            # Reset stats
            self._hits = 0
            self._misses = 0
        except Exception as e:
            logger.error(f"Error clearing FAQ cache: {e}")
    async def get_stats(self) -> Dict[str, Any]:
        """
        Get cache statistics.
        
        Returns:
            Dictionary with cache stats
        """
        try:
            # Get actual count of FAQ cache keys in Redis
            pattern = f"{self._prefix}*"
            keys = await self._redis_client.client.keys(pattern)
            actual_size = len(keys)
        except Exception as e:
            logger.error(f"Error getting cache size: {e}")
            actual_size = 0
        
        return {
            "max_size": self._max_size,  # Reference limit
            "current_size": actual_size,  # Actual keys in Redis
            "hits": self._hits,
            "misses": self._misses,
            "hit_rate": self.get_hit_rate(),
            "ttl_seconds": self._ttl_seconds
        }
    
    def get_hit_rate(self) -> float:
        """
        Calculate cache hit rate.
        
        Returns:
            Hit rate as float (0.0 to 1.0)
        """
        total = self._hits + self._misses
        if total == 0:
            return 0.0
        return self._hits / total


class FAQAgent:
    """
    FAQ Agent for answering questions about clinic services.
    
    This agent:
    - Searches knowledge base for information
    - Uses message templates for standard responses
    - Provides information about treatments, prices, policies
    - Signals low confidence when uncertain
    - Offers escalation when needed
    - Caches responses for frequently asked questions
    
    Requirements: 5.1, 5.2, 5.3, 5.4, 5.5, 5.6, 5.8, 13.1, 13.2, 13.3, 13.4, 13.5
    """
    
    def __init__(
        self,
        llm_config: Dict[str, Any],
        enable_cache: bool = True,
        cache_ttl_seconds: int = 3600,
        cache_max_size: int = 100,
        knowledge_memory: Optional[RedisKnowledgeMemory] = None,
    ):
        """
        Initialize FAQ Agent.
        
        Args:
            llm_config: LLM configuration dictionary (uses Grok for reasoning)
            enable_cache: Enable response caching
            cache_ttl_seconds: Cache TTL in seconds (default: 1 hour)
            cache_max_size: Maximum cache size (default: 100 entries)
        """
        self.llm_config = llm_config
        self.enable_cache = enable_cache
        self.memory = knowledge_memory
        
        # Initialize cache
        if enable_cache:
            self._cache = RedisFAQCache(ttl_seconds=cache_ttl_seconds, max_size=cache_max_size)
            logger.info(f"FAQ cache enabled: TTL={cache_ttl_seconds}s, max_size={cache_max_size}")
        else:
            self._cache = None
            logger.info("FAQ cache disabled")
        
        # FAQ Agent uses Grok for better reasoning and knowledge synthesis
        logger.info(f"FAQ Agent initialized with {llm_config.get('provider', 'unknown')} provider")
        
        self.model_client = self._create_model_client()
        self.agent = self._create_agent()
        if self.memory:
            logger.info("FAQ Agent connected to Redis knowledge memory")
        
        logger.info(f"FAQ Agent initialized with AutoGen 0.4 configuration (provider: {llm_config.get('provider')})")
    
    def _create_model_client(self) -> SKChatCompletionAdapter:
        """
        Create model client using Semantic Kernel.
        
        Uses GoogleAIChatCompletion for Gemini and OpenAIChatCompletion
        with AsyncOpenAI (custom base_url) for xAI Grok or OpenAI.
        
        Returns:
            SKChatCompletionAdapter wrapping the appropriate SK connector
        """
        provider = self.llm_config.get("provider", "xai")

        if provider == "gemini":
            # Gemini via Semantic Kernel GoogleAI connector
            sk_client = GoogleAIChatCompletion(
                gemini_model_id=self.llm_config.get("model", "gemini-1.5-flash"),
                api_key=self.llm_config["api_key"],
            )
            prompt_settings = GoogleAIChatPromptExecutionSettings(
                temperature=self.llm_config.get("temperature", 0.7),
                max_output_tokens=self.llm_config.get("max_tokens", 2048),
            )
        elif provider == "xai":
            # Grok via Semantic Kernel OpenAI connector with custom base_url
            async_client = AsyncOpenAI(
                api_key=self.llm_config["api_key"],
                base_url=self.llm_config.get("base_url", "https://api.x.ai/v1"),
            )
            sk_client = OpenAIChatCompletion(
                ai_model_id=self.llm_config.get("model", "grok-2"),
                async_client=async_client,
            )
            prompt_settings = OpenAIChatPromptExecutionSettings(
                temperature=self.llm_config.get("temperature", 0.7),
                max_tokens=self.llm_config.get("max_tokens", 2048),
            )
        elif provider == "openai":
            # OpenAI via OpenAI-compatible SK connector
            async_client = AsyncOpenAI(
                api_key=self.llm_config["api_key"],
                base_url=self.llm_config.get("base_url", "https://api.openai.com/v1"),
            )
            sk_client = OpenAIChatCompletion(
                ai_model_id=self.llm_config.get("model", "gpt-4o-mini"),
                async_client=async_client,
            )

            # GPT-5 models use max_completion_tokens and don't support custom temperature
            model_name = self.llm_config.get("model", "gpt-4o-mini")
            if model_name.startswith("gpt-5"):
                prompt_settings = OpenAIChatPromptExecutionSettings(
                    # gpt-5 only supports default temperature=1
                    max_completion_tokens=self.llm_config.get("max_tokens", 4000),
                )
            else:
                prompt_settings = OpenAIChatPromptExecutionSettings(
                    temperature=self.llm_config.get("temperature", 0.7),
                    max_tokens=self.llm_config.get("max_tokens", 4000),
                )
        else:
            raise ValueError(f"Unsupported provider: {provider}")

        # Define model capabilities
        model_info = ModelInfo(
            vision=provider == "gemini",  # Gemini supports vision
            function_calling=True,
            json_output=True,
            family=provider,
        )
        
        # Wrap SK client with SKChatCompletionAdapter for AutoGen
        return SKChatCompletionAdapter(
            sk_client,
            kernel=Kernel(memory=NullMemory()),
            prompt_settings=prompt_settings,
            model_info=model_info,
        )

    def _create_agent(self) -> AssistantAgent:
        """Create the AutoGen 0.4 AssistantAgent with tools."""
        return AssistantAgent(
            name="faq",
            description="FAQ agent for answering questions about treatments, prices, and policies",
            system_message=FAQ_SYSTEM_PROMPT,
            model_client=self.model_client,
            tools=self._build_tools(),
            reflect_on_tool_use=True,  # Enable for better response synthesis
        )

    def _build_tools(self) -> List[FunctionTool]:
        """
        Provide structured FunctionTool wrappers so the LLM understands how to query
        the cached knowledge base and message templates.
        """
        async def search_knowledge_base_tool(
            query: str,
        ) -> str:
            """Search knowledge base with query. Returns top 10 most relevant entries."""
            result = await search_knowledge_base(
                query=query,
                top_k=10,
                category=None,
            )
            
            # Format result in a more LLM-friendly way
            entries = result.get("entries", [])
            if not entries:
                return "No results found in knowledge base."
            
            formatted_lines = ["Knowledge Base Results:"]
            for i, entry in enumerate(entries[:10], 1):
                title = entry.get("title", "Untitled")
                content = entry.get("content", "No content")
                formatted_lines.append(f"\n{i}. {title}")
                formatted_lines.append(f"   {content}")
            
            return "\n".join(formatted_lines)

        async def get_message_template_tool(template_name: str) -> str:
            result = await get_message_template(template_name)
            return json.dumps(result)

        async def format_template_tool(
            template_name: str,
            variables_json: str,
        ) -> str:
            """Format template with variables provided as JSON string."""
            try:
                variables = json.loads(variables_json) if variables_json else {}
            except json.JSONDecodeError:
                logger.error(f"Invalid JSON in variables_json: {variables_json}")
                return json.dumps(None)
            result = await format_template(template_name, variables)
            return json.dumps(result) if result else json.dumps(None)

        return [
            FunctionTool(
                search_knowledge_base_tool,
                description=(
                    "Busca conteúdos relevantes no cache da base de conhecimento da clínica "
                    "utilizando palavras-chave e categorias para responder dúvidas de pacientes."
                ),
            ),
            FunctionTool(
                get_message_template_tool,
                description=(
                    "Recupera templates de mensagens prontos no Redis para garantir consistência "
                    "em respostas frequentes antes de personalizar o texto."
                ),
            ),
            FunctionTool(
                format_template_tool,
                description=(
                    "Aplica variáveis em templates de mensagem retornando o texto formatado para "
                    "envio ao paciente."
                ),
            ),
        ]
    
    # Removed _parse_response method - now using centralized utils.response_parser
    
    async def answer_question(
        self,
        question: str,
        contact_name: Optional[str] = None,
        context: Optional[List[Dict[str, str]]] = None
    ) -> Dict[str, Any]:
        """
        Answer a question about clinic services.

        AutoGen 0.4 Async Pattern:
        This method demonstrates async agent calls with caching:
        1. Check cache first (if enabled)
        2. Create CancellationToken for request
        3. Wrap message in TextMessage object
        4. Call agent.on_messages() with await
        5. Parse Response object
        6. Cache high-confidence responses
        
        Args:
            question: User's question
            contact_name: Optional contact name for personalization
            context: Optional conversation history
            
        Returns:
            Dictionary with answer and metadata:
            {
                "answer": "A depilação a laser...",
                "confidence": "high" | "low",
                "sources": ["kb_article_1", "template_name"],
                "should_escalate": false,
                "offer_booking": true,
                "cached": false
            }
        """
        try:
            logger.info(f"FAQ answering question: '{question[:50]}...'")
            
            # Check cache first (if enabled)
            if self.enable_cache and self._cache:
                cached_response = await self._cache.get(question)
                if cached_response:
                    # Personalize cached response if name provided
                    if contact_name and "answer" in cached_response:
                        # Simple personalization - could be more sophisticated
                        cached_response["answer"] = cached_response["answer"]
                    
                    cached_response["cached"] = True
                    return cached_response
            
            # Build context string
            context_str = ""
            if context:
                context_str = "\n\n**Histórico:**\n"
                for msg in context[-3:]:  # Last 3 messages
                    role = msg.get("role", "unknown")
                    content = msg.get("content", "")
                    context_str += f"{role}: {content}\n"

            memory_section = ""
            if self.memory:
                memory_hits = await self.memory.query(question, top_k=3)
                if memory_hits:
                    snippets = []
                    for doc in memory_hits[:3]:
                        title = doc.get("title") or doc.get("id", "Documento")
                        excerpt = (doc.get("content") or "").strip()
                        if len(excerpt) > 240:
                            excerpt = excerpt[:237].rsplit(" ", 1)[0] + "..."
                        source = doc.get("source", "memoria")
                        snippets.append(f"- **{title}** ({source}): {excerpt}")
                    memory_section = "\n**Conhecimento Recuperado:**\n" + "\n".join(snippets) + "\n"

            
            # Add contact name if available
            name_str = ""
            if contact_name:
                name_str = f"\n**Nome do Paciente:** {contact_name}\n"
            
            # Prepare prompt
            prompt = f"""
{context_str}{name_str}{memory_section}

**Pergunta do Paciente:**
{question}

**Tarefa:**
1. Busque informações relevantes na base de conhecimento
2. Use templates quando apropriado
3. Forneça resposta clara e completa
4. Mencione contraindicações se relevante
5. Ofereça agendamento quando apropriado
6. Se não tiver certeza, sinalize com "ESCALATE_LOW_CONFIDENCE"
"""

            # Execute request via AutoGen 0.4 run() API with cancellation support
            cancellation_token = CancellationToken()

            try:
                run_result = await self.agent.run(
                    task=prompt,
                    cancellation_token=cancellation_token,
                )

                # Parse TaskResult messages using centralized parser
                response_text = parse_messages_from_run_result(run_result, "faq")
                logger.info(f"FAQ LLM raw response (first 500 chars): {response_text[:500]}")
                
                # Check if LLM returned raw tool output instead of synthesizing
                if response_text.strip().startswith("Knowledge Base Results:"):
                    logger.warning("LLM returned raw tool output, forcing synthesis...")
                    # Extract the KB results and manually synthesize
                    lines = response_text.split("\n")
                    treatments = []
                    for line in lines:
                        if line.strip() and line[0].isdigit() and "." in line:
                            # Extract treatment name (e.g., "1. Harmonização Facial")
                            treatment = line.split(".", 1)[1].strip()
                            treatments.append(treatment)
                    
                    if treatments:
                        response_text = f"Olá! 😊 Oferecemos diversos tratamentos estéticos:\n\n"
                        response_text += "\n".join(f"✨ {t}" for t in treatments)
                        response_text += "\n\nGostaria de saber mais sobre algum procedimento específico? Posso ajudá-lo(a) a agendar uma avaliação!"
                    else:
                        response_text = "Olá! 😊 Oferecemos diversos tratamentos estéticos. Gostaria de saber sobre algum procedimento específico?"
            finally:
                # Ensure cancellation token is properly cleaned up
                try:
                    if cancellation_token and not cancellation_token.is_cancelled():
                        cancellation_token.cancel()
                except Exception as cleanup_error:
                    logger.warning(f"Error during cancellation token cleanup: {cleanup_error}")
            
            # Check for low confidence signal
            should_escalate = "ESCALATE_LOW_CONFIDENCE" in response_text
            confidence = "low" if should_escalate else "high"
            
            # Remove escalation marker from response
            if should_escalate:
                response_text = response_text.replace("ESCALATE_LOW_CONFIDENCE", "").strip()
                # Add escalation offer
                response_text += "\n\nGostaria de falar com um de nossos especialistas para mais detalhes?"
            
            # Determine if should offer booking
            booking_keywords = [
                "agendar", "horário", "disponível", "marcar",
                "consulta", "avaliação", "sessão"
            ]
            offer_booking = any(keyword in question.lower() for keyword in booking_keywords)
            
            # Extract sources from response if LLM used tools
            # The LLM should have already processed tool results into natural language
            sources = []
            
            result = {
                "answer": response_text,
                "confidence": confidence,
                "sources": sources,
                "should_escalate": should_escalate,
                "offer_booking": offer_booking,
                "cached": False
            }
            
            # Cache response if high confidence and cache enabled
            if self.enable_cache and self._cache and confidence == "high":
                await self._cache.set(question, result) # await para o método set assíncrono
            
            logger.info(
                f"FAQ answered: confidence={confidence}, "
                f"should_escalate={should_escalate}, offer_booking={offer_booking}"
            )
            
            return result

        except ValueError as e:
            # Response parsing error - categorize as UNCLEAR_REQUEST
            logger.error(f"Error parsing FAQ response: {e}", exc_info=True)
            fallback_msg = get_fallback_response(ErrorType.UNCLEAR_REQUEST)
            return {
                "answer": fallback_msg,
                "confidence": "low",
                "sources": [],
                "should_escalate": True,
                "offer_booking": False,
                "cached": False,
                "error_type": ErrorType.UNCLEAR_REQUEST.value
            }
        except Exception as e:
            # Unknown error - categorize and determine recovery action
            logger.error(f"Error in FAQ agent: {e}", exc_info=True)
            logger.error(f"Exception type: {type(e).__name__}")
            error_type = ErrorType.UNKNOWN_ERROR
            fallback_msg = get_fallback_response(error_type)

            # Get recovery action
            recovery_action = ErrorRecoveryStrategy.get_recovery_action(error_type)
            should_escalate = recovery_action == "escalate_to_human"

            return {
                "answer": fallback_msg,
                "confidence": "low",
                "sources": [],
                "should_escalate": should_escalate,
                "offer_booking": False,
                "cached": False,
                "error_type": error_type.value,
                "recovery_action": recovery_action
            }
    
    async def get_cache_stats(self) -> Optional[Dict[str, Any]]:
        """
        Get cache statistics.
        
        Returns:
            Dictionary with cache stats or None if cache disabled
        """
        if not self.enable_cache or not self._cache:
            return None
        
        return await self._cache.get_stats()
    
    async def clear_cache(self):
        """
        Clear FAQ cache.
        """
        if self.enable_cache and self._cache:
            await self._cache.clear()
            logger.info("FAQ cache cleared")
    async def warm_cache(self, common_questions: List[str]):
        """
        Warm up cache with common questions.
        
        Args:
            common_questions: List of common questions to pre-cache
        """
        if not self.enable_cache or not self._cache:
            logger.warning("Cannot warm cache - caching is disabled")
            return
        
        logger.info(f"Warming FAQ cache with {len(common_questions)} common questions...")
        
        for question in common_questions:
            try:
                # Process question to cache response
                result = await self.answer_question(question)
                logger.debug(f"Cached: {question[:50]}...")
            except Exception as e:
                logger.error(f"Error warming cache for '{question[:50]}...': {e}")
        
        stats = await self.get_cache_stats()
        size = stats.get('current_size', 0) if stats else 0
        logger.info(f"Cache warming complete. Cache size: {size}")

    @staticmethod
    def _looks_like_tool_payload(response: str) -> bool:
        """Detect if the LLM returned a raw JSON payload instead of natural text."""
        if not response:
            return False
        stripped = response.strip()
        if stripped.startswith("{") and "\"entries\"" in stripped and "\"sources\"" in stripped:
            return True
        if stripped.startswith("[{") and "\"title\"" in stripped and "\"content\"" in stripped:
            return True
        return False

    @staticmethod
    def _format_entries_response(entries: List[Dict[str, Any]]) -> str:
        """Format KB entries into a human-friendly answer."""
        if not entries:
            return "Ainda não encontrei informações específicas. Posso verificar com nossa equipe para você?"

        lines: List[str] = []
        primary = entries[0]
        title = primary.get("title")
        content = primary.get("content")

        if title:
            lines.append(f"📘 {title}")
        if content:
            lines.append(content)

        extras = entries[1:3]
        if extras:
            lines.append("")
            lines.append("Outras referências úteis:")
            for entry in extras:
                extra_title = entry.get("title")
                extra_content = entry.get("content")
                bullet_parts = []
                if extra_title:
                    bullet_parts.append(extra_title)
                if extra_content:
                    bullet_parts.append(extra_content)
                if bullet_parts:
                    lines.append(f"• {' — '.join(bullet_parts)}")

        lines.append("")
        lines.append("Posso ajudar com mais alguma dúvida ou agendar um horário?")
        return "\n".join(line for line in lines if line)
    
    async def get_treatment_info(self, treatment_name: str) -> Dict[str, Any]:
        """
        Get detailed information about a specific treatment.
        
        Args:
            treatment_name: Name of the treatment
            
        Returns:
            Dictionary with treatment information
        """
        try:
            logger.info(f"Getting treatment info: {treatment_name}")
            
            # Search knowledge base
            search_result = await search_knowledge_base(
                query=treatment_name,
                top_k=1,
                category="treatments"
            )
            results = search_result.get("entries", [])

            if not results:
                return {
                    "found": False,
                    "message": f"Não encontrei informações sobre '{treatment_name}'. Gostaria de falar com nossa equipe?"
                }

            treatment = results[0]

            return {
                "found": True,
                "title": treatment.get("title"),
                "description": treatment.get("content"),
                "category": treatment.get("category"),
                "keywords": treatment.get("keywords", [])
            }
            
        except Exception as e:
            logger.error(f"Error getting treatment info: {e}")
            return {
                "found": False,
                "message": "Erro ao buscar informações. Por favor, tente novamente."
            }
    
    async def cleanup(self):
        """Cleanup resources."""
        if self.model_client and hasattr(self.model_client, 'close'):
            try:
                await self.model_client.close()
                logger.info("FAQ Agent model client closed")
            except Exception as e:
                logger.error(f"Error closing FAQ Agent model client: {e}")


def create_faq_agent(
    llm_config: Dict[str, Any],
    enable_cache: bool = True,
    cache_ttl_seconds: int = 3600,
    cache_max_size: int = 100
) -> FAQAgent:
    """
    Factory function to create an FAQ Agent.
    
    Args:
        llm_config: LLM configuration dictionary (uses Grok for reasoning)
        enable_cache: Enable response caching
        cache_ttl_seconds: Cache TTL in seconds (default: 1 hour)
        cache_max_size: Maximum cache size (default: 100 entries)
        
    Returns:
        FAQAgent instance
    """
    knowledge_memory = RedisKnowledgeMemory()

    return FAQAgent(
        llm_config,
        enable_cache,
        cache_ttl_seconds,
        cache_max_size,
        knowledge_memory=knowledge_memory,
    )


