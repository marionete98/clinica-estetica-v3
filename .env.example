# ============================================
# LLM Configuration
# ============================================
# Provider selection: 'xai' or 'gemini'
MODEL_PROVIDER=xai

# xAI Grok Configuration
XAI_API_KEY=sk-your-xai-api-key-here
XAI_MODEL=grok-4-reasoning
XAI_BASE_URL=https://api.x.ai/v1

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ============================================
# Database Configuration
# ============================================
# Supabase Postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ============================================
# Cache Configuration
# ============================================
# Redis Cloud
REDIS_URL=redis://default:password@your-redis-host:6379
REDIS_PASSWORD=your-redis-password
REDIS_HOST=your-redis-host.cloud.redislabs.com
REDIS_PORT=6379

# ============================================
# Chatwoot Configuration
# ============================================
# Chatwoot API
CHATWOOT_API_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=12345
CHATWOOT_API_TOKEN=your-chatwoot-api-token-here
CHATWOOT_WEBHOOK_SECRET=your-webhook-secret-here

# Finance Team Configuration (for handoff to different WhatsApp number)
CHATWOOT_FINANCE_INBOX_ID=123  # Inbox ID do Financeiro no Chatwoot
CHATWOOT_FINANCE_TEAM_ID=456   # [Opcional] Team ID do Financeiro
CHATWOOT_FINANCE_PHONE="+55 94 99123-4567"  # Número do WhatsApp do Financeiro

# ============================================
# Calendar API Integration
# ============================================
# External calendar system API
CALENDAR_API_URL=https://clinica-luana-calendar-production.up.railway.app/api
CALENDAR_API_TIMEOUT=10

# ============================================
# Application Configuration
# ============================================
# Environment: development, staging, production
ENV=development

# Logging
LOG_LEVEL=INFO

# Agent Configuration
MAX_TOOL_CALLS_PER_SESSION=3
RESPONSE_TIMEOUT_SECONDS=10
MAX_CONTEXT_MESSAGES=20

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=100

# Message Processing
MESSAGE_DEDUP_TTL_SECONDS=300
MESSAGE_PROCESSING_DELAY_SECONDS=7

# FAQ Cache
FAQ_CACHE_ENABLED=true
FAQ_CACHE_TTL_SECONDS=3600
FAQ_CACHE_MAX_SIZE=100

# Message Processing
MESSAGE_DEDUP_TTL_SECONDS=300  # 5 minutes
MESSAGE_PROCESSING_DELAY_SECONDS=7  # 7 seconds for batching

# Business Hours (24h format)
BUSINESS_HOURS_START=08:30
BUSINESS_HOURS_END=19:00
BUSINESS_HOURS_SAT_END=12:00

# Policies
MIN_BOOKING_ADVANCE_HOURS=1
HARMONIZATION_CANCEL_HOURS=4
LASER_CANCEL_HOURS=24
MAX_RESCHEDULE_COUNT=2

# Reminders
REMINDER_D1_HOURS_BEFORE=24
REMINDER_H2_HOURS_BEFORE=2

# ============================================
# Monitoring and Observability
# ============================================
# Metrics thresholds
P95_LATENCY_THRESHOLD_MS=7000
ERROR_RATE_THRESHOLD_PERCENT=2
HANDOVER_RATE_THRESHOLD_PERCENT=30

# Alert configuration
ALERT_EMAIL=admin@clinicaluana.com.br
ENABLE_EMAIL_ALERTS=false

# ============================================
# Railway Deployment
# ============================================
# Railway will inject PORT automatically
PORT=8000
